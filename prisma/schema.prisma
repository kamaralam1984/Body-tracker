// Production data model for the Body Tracker API Platform.
//
// This schema is the real persistence layer, backed by a real Neon
// Postgres instance (connection config lives in prisma.config.ts and
// .env.local — Prisma 7 no longer supports `datasource.url` directly in
// the schema file). Route handlers under src/app/api/v1/** and their
// src/server/services/* query this schema directly via the shared
// PrismaClient singleton in src/server/db/prisma.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  admin
  manager
  member
  viewer
}

enum UserStatus {
  active
  invited
  suspended
}

enum Plan {
  starter
  growth
  enterprise
}

enum TrackingStatus {
  idle
  active
  paused
  completed
}

enum TrackingEventType {
  started
  paused
  resumed
  rep
  form_alert
  completed
  distraction
  drowsiness_alert
  gesture
}

// Sitting/standing are plausible from a desk webcam; walking/running require
// the lower body to actually be visible and moving, which is rare for a
// laptop-camera desk setup — see classifyMovementState() in
// intelligence-metrics-service.ts for exactly how this is derived.
enum MovementState {
  sitting
  standing
  walking
  running
  idle
}

enum ReportFormat {
  pdf
  csv
}

enum ReportStatus {
  queued
  generating
  ready
  failed
}

enum WebhookEventType {
  session_started
  session_completed
  tracking_form_alert
  report_ready
  user_invited
}

enum WebhookStatus {
  active
  disabled
}

enum ApiKeyStatus {
  active
  revoked
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(starter)
  createdAt DateTime @default(now())

  teams                 Team[]
  users                 User[]
  apiKeys               ApiKey[]
  trackingSessions      TrackingSession[]
  trackingMetricSamples TrackingMetricSample[]
  exerciseSets          ExerciseSet[]
  analyticsSnapshots    AnalyticsSnapshot[]
  reports               Report[]
  webhooks              Webhook[]
  auditLog              AuditLogEntry[]
  oauthClients          OAuthClient[]
  serviceAccounts       ServiceAccount[]

  @@map("organizations")
}

model Team {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users        User[]

  @@index([orgId])
  @@map("teams")
}

model User {
  id           String     @id @default(cuid())
  orgId        String
  teamId       String?
  email        String
  passwordHash String
  name         String
  role         Role       @default(member)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())

  organization            Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team                    Team?                    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  refreshTokens           RefreshToken[]
  apiKeys                 ApiKey[]
  trackingSessions        TrackingSession[]
  trackingMetricSamples   TrackingMetricSample[]
  exerciseSets            ExerciseSet[]
  analyticsSnapshots      AnalyticsSnapshot[]
  reports                 Report[]
  auditLogEntries         AuditLogEntry[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]

  @@unique([orgId, email])
  @@index([orgId])
  @@map("users")
}

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  // Empty/null on normal login-issued refresh tokens (full role-based
  // scopes on refresh, today's existing behavior, unchanged). Set only on
  // OAuth2-issued refresh tokens, so rotating them via /api/v1/oauth/token
  // re-signs a new access token restricted to the SAME consented scopes
  // instead of silently escalating back to the user's full role scopes.
  scopes        String[]
  oauthClientId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Exactly one of userId/serviceAccountId is set — a personal key (owned by
// a human User, inherits nothing extra, scoped to what was picked at
// creation) or a service-account key (owned by a ServiceAccount, see below
// — no human role backs it, scopes are the ONLY source of its permissions).
// Not enforced by a DB constraint (Postgres doesn't have a clean
// standard way to express "exactly one of two nullable FKs" without a
// trigger); enforced at the application layer in the two distinct
// creation routes instead.
model ApiKey {
  id                 String       @id @default(cuid())
  orgId              String
  userId             String?
  serviceAccountId   String?
  name               String
  keyPrefix          String
  keyHash            String       @unique
  scopes             String[]
  status             ApiKeyStatus @default(active)
  rateLimitPerMinute Int          @default(120)
  requestCount       Int          @default(0)
  lastUsedAt         DateTime?
  createdAt          DateTime     @default(now())
  expiresAt          DateTime?
  revokedReason      String?
  // "live" for every key issued before this field existed (and the
  // default for new ones) — matches actual real-world usage today, see
  // signAccessToken/generateApiKey call sites.
  environment        String       @default("live")
  // "secret" (server-side, full scopes) or "publishable" (client-safe,
  // creation-time forced to read-only-eligible scopes — see
  // src/app/api/v1/api-keys/route.ts).
  keyType            String       @default("secret")
  // CIDR (e.g. "203.0.113.0/24") or exact-IP entries — empty array means
  // "no restriction" (today's behavior, unchanged for existing keys).
  allowedIps         String[]
  // Wildcard-capable origins (e.g. "*.example.com") — empty array means
  // "no restriction".
  allowedOrigins     String[]
  // Set only on the OLD row during a rotation (see
  // src/app/api/v1/api-keys/[id]/rotate/route.ts) — both this row and its
  // replacement authenticate successfully until this passes, then a sweep
  // in src/instrumentation.ts revokes this row. Null for a key that was
  // never rotated or that IS itself a rotation's replacement.
  gracePeriodEndsAt  DateTime?
  // Points at the OLD key this row replaced, if this row was created by a
  // rotation — real rotation history is derived from AuditLogEntry rows
  // (action "api-key.rotated"), not a separate table; this column is just
  // enough to link a still-active grace-period pair together.
  supersedesId       String?      @unique

  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceAccount ServiceAccount? @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  supersedes     ApiKey?         @relation("ApiKeyRotation", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy   ApiKey?         @relation("ApiKeyRotation")

  @@index([orgId])
  @@map("api_keys")
}

// A machine identity, not a human — for CI/CD pipelines and backend
// integrations. Scopes on its API keys are explicit at creation time,
// never inherited from a role the way a human User's keys can draw on
// ROLE_SCOPES (see src/server/http/principal.ts) — a service account has
// no "role" in the human sense (Principal.role is the synthetic string
// "service_account" for these).
//
// Real, honest limitation: resources that model "created by a human"
// (TrackingSession.userId, Report.userId — both FK to User, not
// ServiceAccount) reject writes from a service-account principal with a
// real database constraint error, not a fabricated success — a tracking
// session inherently belongs to the person being tracked, so this isn't
// an arbitrary gap, it's the actual domain model. Service accounts are
// for the machine-appropriate surface: webhooks, OAuth clients, reading
// analytics/reports, not creating sessions on a human's behalf.
model ServiceAccount {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  status    ApiKeyStatus @default(active)
  createdAt DateTime     @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  apiKeys      ApiKey[]

  @@index([orgId])
  @@map("service_accounts")
}

model TrackingSession {
  id               String         @id @default(cuid())
  orgId            String
  userId           String
  title            String
  activityKind     String
  status           TrackingStatus @default(idle)
  startedAt        DateTime?
  pausedAt         DateTime?
  endedAt          DateTime?
  durationSeconds  Int            @default(0)
  repCount         Int            @default(0)
  caloriesEstimate Int            @default(0)
  avgFormScore     Float          @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization  Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  events        TrackingEvent[]
  metricSamples TrackingMetricSample[]
  exerciseSets  ExerciseSet[]

  @@index([orgId, status])
  @@map("tracking_sessions")
}

model TrackingEvent {
  id        String            @id @default(cuid())
  sessionId String
  type      TrackingEventType
  message   String
  data      Json
  createdAt DateTime          @default(now())

  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("tracking_events")
}

/**
 * One row per ~10s window of live face-tracking during an active
 * TrackingSession — the fine-grained signal the "Attention"/"Posture"/
 * "Wellness" dashboards are computed from (see
 * src/server/services/intelligence-metrics-service.ts). Raw landmarks never
 * reach the server; the browser tallies these aggregates client-side (see
 * src/features/tracking/hooks/use-tracking-session-sync.ts) and the scores
 * are computed server-side on ingestion (src/app/api/v1/tracking/[sessionId]/metrics/route.ts)
 * so the formulas can be tuned without a client redeploy.
 */
model TrackingMetricSample {
  id        String @id @default(cuid())
  orgId     String
  userId    String
  sessionId String

  windowStart DateTime
  windowEnd   DateTime

  frameCount        Int
  facePresentFrames Int

  blinkCount           Int // discrete blink closures in this window
  eyesClosedFrameCount Int // frames with eyes closed — PERCLOS numerator
  longEyeClosureCount  Int // closures sustained >= LONG_CLOSURE_MS — microsleep proxy

  avgHeadYawDev   Float // baseline-relative, degrees — computed client-side from the session's calibrated neutral pose
  avgHeadPitchDev Float
  avgHeadRollDev  Float
  yawStdDev       Float
  pitchStdDev     Float
  rollStdDev      Float

  attentionScore Float // 0-100, computed server-side — see intelligence-metrics-service.ts
  postureScore   Float
  fatigueScore   Float

  // Movement fields are nullable — only populated when "pose" tracking mode
  // is on for this window (off by default). motionEnergy/lowerBodyVisible/
  // gaitCadencePerMin are the raw client-tallied inputs; movementState is
  // computed server-side from them, same principle as the scores above.
  motionEnergy      Float?
  lowerBodyVisible  Boolean?
  gaitCadencePerMin Float?
  movementState     MovementState?

  createdAt DateTime @default(now())

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([orgId, userId, windowStart])
  @@index([sessionId, windowStart])
  @@map("tracking_metric_samples")
}

/**
 * A completed burst of repetitive motion, auto-detected client-side from
 * pose landmarks (peak/valley cycles in hip+shoulder height — see
 * use-tracking-session-sync.ts) — NOT tied to a specific exercise. Which
 * exercise it is (squat vs. shoulder-roll vs. lunge) isn't determinable
 * without a trained per-exercise classifier, so `exerciseName` is always the
 * generic "Movement set" rather than a fabricated specific label.
 */
model ExerciseSet {
  id               String   @id @default(cuid())
  orgId            String
  userId           String
  sessionId        String
  exerciseName     String
  reps             Int
  durationSeconds  Int
  caloriesEstimate Int
  createdAt        DateTime @default(now())

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([orgId, userId, createdAt])
  @@map("exercise_sets")
}

model AnalyticsSnapshot {
  id                String   @id @default(cuid())
  orgId             String
  userId            String
  date              DateTime @db.Date
  activeMinutes     Int
  sessionsCompleted Int
  repsTotal         Int
  avgFormScore      Float
  focusScore        Float
  postureScore      Float

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([orgId, date])
  @@map("analytics_snapshots")
}

model Report {
  id          String       @id @default(cuid())
  orgId       String
  userId      String
  title       String
  format      ReportFormat
  status      ReportStatus @default(queued)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime     @default(now())
  readyAt     DateTime?
  sizeBytes   Int?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@map("reports")
}

model Webhook {
  id        String             @id @default(cuid())
  orgId     String
  url       String
  secret    String
  events    WebhookEventType[]
  status    WebhookStatus      @default(active)
  createdAt DateTime           @default(now())

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([orgId])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String           @id @default(cuid())
  webhookId      String
  event          WebhookEventType
  payload        Json
  attempt        Int              @default(1)
  status         String
  responseStatus Int?
  durationMs     Int?
  createdAt      DateTime         @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

model AuditLogEntry {
  id        String   @id @default(cuid())
  orgId     String
  // Null for system-initiated events (e.g. the expired/rotated-out API-key
  // auto-revoke sweep in src/server/services/api-keys-service.ts) — there's
  // no real human actor to attribute those to, and fabricating one (or
  // reusing an arbitrary org member's id) would misattribute a real audit
  // record. `writeAudit()`'s `actorId` param stays required for the many
  // real human-initiated call sites; only the sweep passes null.
  actorId   String?
  action    String
  target    String
  metadata  Json
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("audit_log")
}

// Deliberately NOT a relation to Organization/User/ApiKey (unlike
// AuditLogEntry) — a request log must still write for unauthenticated,
// failed-auth, or post-deletion requests, and a plain nullable string id
// never blocks on referential integrity the way a real FK relation would.
model ApiRequestLog {
  id         String   @id @default(cuid())
  orgId      String?
  userId     String?
  apiKeyId   String?
  method     String
  path       String
  statusCode Int
  latencyMs  Int
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([path, createdAt])
  @@map("api_request_log")
}

// This app acting as its own OAuth2 provider (RFC 6749 authorization-code
// grant + RFC 7636 PKCE) — future-ready for third-party integrations, no
// external identity provider dependency. Issued access/refresh tokens are
// the same real JWTs src/server/auth/tokens.ts already produces (see its
// `scopes` field), not a parallel token system.
model OAuthClient {
  id               String   @id @default(cuid())
  orgId            String
  name             String
  clientId         String   @unique
  clientSecretHash String
  redirectUris     String[]
  scopes           String[]
  createdAt        DateTime @default(now())

  organization       Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  authorizationCodes OAuthAuthorizationCode[]

  @@index([orgId])
  @@map("oauth_clients")
}

// Single-use, short-lived (10 min) — only the SHA-256 hash of the actual
// code is ever stored, same discipline as ApiKey.keyHash/RefreshToken.
model OAuthAuthorizationCode {
  id                  String   @id @default(cuid())
  codeHash            String   @unique
  clientId            String
  userId              String
  redirectUri         String
  scopes              String[]
  codeChallenge       String
  codeChallengeMethod String
  used                Boolean  @default(false)
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("oauth_authorization_codes")
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# npm workspaces sometimes can't hoist every sub-dependency to the root
# node_modules (version conflicts) and installs a package-local one instead.
/packages/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/

# real user-uploaded files — stored outside public/ deliberately, since
# Next.js standalone output copies a build-time snapshot of public/ that
# a runtime write would never reach (see src/app/api/v1/users/me/avatar).
/var/uploads/

# monorepo package build output
/packages/*/dist/
/packages/*/coverage/

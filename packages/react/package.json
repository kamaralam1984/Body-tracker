{
  "name": "@kvl/react",
  "version": "0.1.0",
  "description": "Official React hooks for the Body Tracker JavaScript SDK.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kvl/sdk": "^0.1.0",
    "@tanstack/react-query": "^5.101.4"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.10"
  }
}

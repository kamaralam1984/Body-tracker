# Development container — hot reload via a bind-mounted source tree
# (see docker-compose.dev.yml). Not used for production; that's Dockerfile.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3045
CMD ["npm", "run", "dev", "--", "-p", "3045"]
